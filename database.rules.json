{
  "rules": {
    ".read": false,
    ".write": false,
    "tournaments": {
      ".read": true,
      "$tournamentId": {
        ".write": false
      }
    },
    "tournament_teams": {
      "$tournamentId": {
        ".read": true,
        "$teamRegistrationId": {
          ".write": false
        }
      }
    },
    "matches": {
      "$tournamentId": {
        ".read": true,
        "$matchId": {
          ".write": false
        }
      }
    },
    "standings": {
      "$tournamentId": {
        ".read": true,
        "$teamId": {
          ".write": false
        }
      }
    },
    "match_audit": {
      "$tournamentId": {
        ".read": "auth != null",
        "$auditId": {
          ".write": false
        }
      }
    }
  }
}
